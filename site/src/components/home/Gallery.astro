---
import { getLangFromUrl, useTranslations, useData } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const d = useData(lang);

const media = [
  { type: "video", src: "/gallery/arming.mp4" },
  { type: "video", src: "/gallery/osd.mp4" },
  {
    type: "themed-image",
    lightSrc: "/gallery/ui-light.webp",
    darkSrc: "/gallery/ui-dark.webp",
  },
] as const;

const items = d<{ label: string; caption: string }[]>("gallery.items");
const slots = media.map((m, i) => ({ ...m, ...items[i] }));
---

<section class="px-6 pt-8 pb-4" id="gallery">
  <div class="max-w-7xl mx-auto">
    <p class="section-kicker">FIELD TEST / 01</p>
    <h2 class="text-3xl md:text-5xl font-bold text-center">{t("gallery.title")}</h2>
    <p class="mt-2 text-center text-[rgb(var(--color-text-muted))]">
      {t("gallery.subtitle")}
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        slots.map((s) => (
          <figure>
            <div class="gallery-frame group relative aspect-video border-2 border-[rgb(var(--color-primary))] bg-[rgb(var(--color-secondary))] overflow-hidden">
              {s.type === "video" ? (
                <video
                  class="w-full h-full object-cover"
                  src={s.src}
                  autoplay
                  loop
                  muted
                  playsinline
                  aria-label={s.label}
                />
              ) : (
                <>
                  <img
                    class="light-only w-full h-full object-cover"
                    src={s.lightSrc}
                    alt={s.label}
                    loading="lazy"
                  />
                  <img
                    class="dark-only w-full h-full object-cover"
                    src={s.darkSrc}
                    alt={s.label}
                    loading="lazy"
                  />
                </>
              )}
            </div>
            <figcaption class="mt-3 px-1">
              <span class="block text-sm font-semibold">{s.label}</span>
              <span class="mt-0.5 block text-sm text-[rgb(var(--color-text-muted))]">
                {s.caption}
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-kicker { margin: 0 0 .8rem; text-align: center; color: rgb(var(--color-accent)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .68rem; font-weight: 700; letter-spacing: .14em; }
  .gallery-frame { box-shadow: 8px 8px 0 rgb(var(--color-secondary)); }
  /* Default (auto): use system preference */
  .light-only {
    display: block;
  }
  .dark-only {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    .light-only {
      display: none;
    }
    .dark-only {
      display: block;
    }
  }

  /* Explicit light mode */
  :global(html.light) .light-only {
    display: block !important;
  }
  :global(html.light) .dark-only {
    display: none !important;
  }

  /* Explicit dark mode */
  :global(html.dark) .light-only {
    display: none !important;
  }
  :global(html.dark) .dark-only {
    display: block !important;
  }
</style>
