---
import CameraMatrix from "../CameraMatrix.astro";
import { getLangFromUrl, useTranslations } from "../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-6 pt-12 pb-4" id="cameras">
  <div class="max-w-6xl mx-auto">
    <p class="section-kicker">COMPATIBILITY / 02</p>
    <h2 class="text-3xl md:text-5xl font-bold text-center">{t("compat.title")}</h2>
    <p class="mt-2 mb-4 text-center text-[rgb(var(--color-text-muted))]">
      {t("compat.subtitle")}
    </p>
    <CameraMatrix />
  </div>
</section>

<style>
  .section-kicker { margin: 0 0 .8rem; text-align: center; color: rgb(var(--color-accent)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .68rem; font-weight: 700; letter-spacing: .14em; }
</style>
