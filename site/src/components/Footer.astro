---
import Socials from "./Socials.astro";
import { AUTHOR } from "../consts";

const year = new Date().getFullYear();
---

<footer
  class="w-full py-8 px-6 bg-[rgb(var(--color-footer-bg))] border-t border-[rgb(var(--color-border))] text-[rgb(var(--color-text-muted))] text-center mt-auto"
>
  <div class="max-w-6xl mx-auto">
    <div
      class="flex flex-col md:flex-row md:justify-between items-center gap-4"
    >
      <div class="footer-lockup">
        <span class="footer-project">SHUTTERBRIDGE</span>
        <span class="text-sm">&copy; {year} {AUTHOR} · Hosted by <a href="/">IbexFuel</a></span>
      </div>
      <Socials />
    </div>
  </div>
</footer>

<style>
  .footer-lockup { display: flex; flex-direction: column; align-items: center; gap: .35rem; }
  .footer-project { color: #f5f7f1; font-weight: 700; letter-spacing: .06em; }
  .footer-lockup a { color: #a6be75; font-weight: 700; }
  @media (min-width: 768px) { .footer-lockup { align-items: flex-start; text-align: left; } }
</style>
