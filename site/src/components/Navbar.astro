---
import HeaderLink from "./HeaderLink.astro";
import ThemeToggle from "./ThemeToggle.svelte";
import LanguageSelector from "./LanguageSelector.svelte";
import Socials from "./Socials.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations, getLocalizedUrl } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeUrl = getLocalizedUrl(lang, "/");

const links = [
  { href: getLocalizedUrl(lang, "/"), label: t("nav.home"), icon: "mdi:home-variant" },
  { href: getLocalizedUrl(lang, "/flash"), label: t("nav.flasher"), icon: "mdi:flash" },
  { href: getLocalizedUrl(lang, "/docs"), label: t("nav.docs"), icon: "mdi:book-open-variant" },
];
---

<header
  class="project-header w-full px-3 sm:px-6 bg-[rgba(var(--color-header-bg),0.94)] border-b border-[rgb(var(--color-border))] sticky top-0 z-30"
>
  <div class="max-w-7xl mx-auto">
    <nav class="min-h-20 flex items-center justify-between gap-4">
      <a
        href={homeUrl}
        class="flex items-center gap-3 text-[rgb(var(--color-text))] no-underline hover:text-[rgb(var(--color-primary))] transition-colors"
      >
        <span class="project-mark"><Icon name="aperture" class="h-7 w-7" /></span>
        <span class="brand-stack"><span class="project-name">SHUTTERBRIDGE</span><span class="project-parent">AN IBEXFUEL PROJECT</span></span>
      </a>

      <div
        class="hidden lg:flex items-center space-x-1 absolute left-1/2 transform -translate-x-1/2"
      >
        {
          links.map((l) => (
            <HeaderLink href={l.href}>
              <Icon name={l.icon} class="w-4 h-4" />
              {l.label}
            </HeaderLink>
          ))
        }
      </div>

      <div class="hidden lg:flex items-center gap-2">
        <a class="ibex-return" href="/">← IbexFuel</a>
        <LanguageSelector currentLang={lang} client:idle />
        <ThemeToggle client:idle />
        <Socials />
      </div>

      <div class="lg:hidden flex items-center gap-1">
        <LanguageSelector currentLang={lang} client:idle />
        <ThemeToggle client:idle />
        <button
          id="mobile-menu-toggle"
          class="flex items-center justify-center w-8 h-8 rounded-lg text-[rgb(var(--color-text))] hover:bg-[rgb(var(--color-secondary))] transition-colors focus:outline-none focus:ring-2 focus:ring-[rgb(var(--color-primary))]"
          aria-label={t("nav.toggleMenu")}
          aria-expanded="false"
        >
          <Icon name="mdi:menu" id="hamburger-icon" class="w-7 h-7" />
          <Icon name="mdi:close" id="close-icon" class="w-7 h-7 hidden" />
        </button>
      </div>
    </nav>

    <div
      id="mobile-menu"
      class="lg:hidden absolute left-0 right-0 top-full bg-[rgb(var(--color-header-bg))] border-b border-[rgb(var(--color-border))] shadow-lg transform -translate-y-full opacity-0 invisible transition-all duration-300 ease-in-out"
    >
      <div class="px-6 py-4 space-y-2">
        <div
          class="space-y-1 border-b border-[rgb(var(--color-border))] pb-4 mb-4"
        >
          {
            links.map((l) => (
              <HeaderLink href={l.href} class="w-full">
                <Icon name={l.icon} class="w-4 h-4" />
                {l.label}
              </HeaderLink>
            ))
          }
        </div>
        <div class="flex items-center justify-between">
          <span class="text-sm text-[rgb(var(--color-text-light))] font-medium"
            >{t("nav.links")}:</span
          >
          <Socials />
        </div>
        <a class="ibex-return mobile-return" href="/">← Back to IbexFuel</a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleButton = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const hamburgerIcon = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");

  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    toggleButton?.setAttribute("aria-expanded", isOpen.toString());
    hamburgerIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);
    mobileMenu?.classList.toggle("-translate-y-full", !isOpen);
    mobileMenu?.classList.toggle("opacity-0", !isOpen);
    mobileMenu?.classList.toggle("invisible", !isOpen);
    mobileMenu?.classList.toggle("translate-y-0", isOpen);
    mobileMenu?.classList.toggle("opacity-100", isOpen);
    mobileMenu?.classList.toggle("visible", isOpen);
  };

  toggleButton?.addEventListener("click", toggleMenu);
  mobileMenu?.querySelectorAll("a[href]").forEach((link) => {
    link.addEventListener("click", () => isOpen && toggleMenu());
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) toggleMenu();
  });
  document.addEventListener("click", (e) => {
    if (
      isOpen &&
      !toggleButton?.contains(e.target as Node) &&
      !mobileMenu?.contains(e.target as Node)
    ) {
      toggleMenu();
    }
  });
</script>

<style>
  .project-header { backdrop-filter: blur(12px); }
  .project-mark { width: 44px; height: 44px; display: grid; place-items: center; color: #f5f7f1; background: rgb(var(--color-primary)); border: 2px solid rgb(var(--color-primary)); border-radius: 5px; box-shadow: 5px 5px 0 rgb(var(--color-accent)); }
  :global(html.dark) .project-mark { color: #16352f; }
  .brand-stack { display: flex; flex-direction: column; line-height: 1; }
  .project-name { font-size: 1.05rem; font-weight: 700; letter-spacing: -.02em; }
  .project-parent { margin-top: .38rem; color: rgb(var(--color-text-muted)); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .58rem; font-weight: 700; letter-spacing: .12em; }
  .ibex-return { min-height: 40px; display: inline-flex; align-items: center; padding: .45rem .75rem; border: 1px solid rgb(var(--color-border)); border-radius: 5px; color: rgb(var(--color-text)); font-size: .78rem; font-weight: 700; text-decoration: none; }
  .ibex-return:hover { color: rgb(var(--color-text)); background: rgb(var(--color-secondary)); }
  .mobile-return { width: 100%; justify-content: center; margin-top: 1rem; }
  @media (max-width: 390px) {
    .project-mark { width: 40px; height: 40px; box-shadow: 4px 4px 0 rgb(var(--color-accent)); }
    .project-name { font-size: .88rem; }
    .project-parent { font-size: .5rem; }
  }
</style>
